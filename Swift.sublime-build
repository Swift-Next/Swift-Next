{
    "target": "exec",
    "selector": "source.swift",
    "file_regex": "^(.+?):(\\d+):(\\d+): (.*)",
    "env": {
        "XPC_FLAGS": "0x0"
    },
    "working_dir": "$file_path",
    "cmd": [
        "swift",
        "$file"
    ],
    "variants": [
        {
            "name": "Package: Build",
            "cmd": [
                "swift",
                "build"
            ],
            "working_dir": "$folder"
        },
        {
            "name": "Package: Test",
            "cmd": [
                "swift",
                "test"
            ],
            "working_dir": "$folder"
        },
        {
            "name": "Package: Resolve",
            "cmd": [
                "swift",
                "package",
                "resolve"
            ],
            "working_dir": "$folder"
        },
        {
            "name": "Package: Update",
            "cmd": [
                "swift",
                "package",
                "update"
            ],
            "working_dir": "$folder"
        },
        {
            "name": "Package: Clean",
            "cmd": [
                "swift",
                "package",
                "clean"
            ],
            "working_dir": "$folder"
        }
    ]
}
